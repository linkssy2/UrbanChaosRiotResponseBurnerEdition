+static int packed_span_capture_options(uint32_t index,unsigned v,unsigned options){
+    if(raw_packet_active){
+        if(raw_capture_packet(NV097_ARRAY_ELEMENT32,(const uint8_t*)&index,1,v))return 1;
+        raw_packets_restore();return 0;
+    }
+    if(!v||v>=MAX_INLINE_VERTS||index>packed_capture_plan.max_index)return 0;
+    unsigned slot=nv_packed_reuse_slot(index),row;
+    if(nv_packed_reuse_key(&packed_reuse,slot,index)){
+        row=packed_reuse.lean[slot].row;
+        if(row>=MAX_INLINE_VERTS)return 0;
+        if(options&2u)packed_order16[v]=(uint16_t)row;else packed_order[v]=row;
+        return 1;
+    }
+    row=packed_reuse.count;
+    if(row>=MAX_INLINE_VERTS)return 0;
+    size_t offset=(size_t)row*packed_draw_layout.stride;
+    if(offset>sizeof(packed_draw_data)||packed_capture_plan.stride>sizeof(packed_draw_data)-offset)return 0;
