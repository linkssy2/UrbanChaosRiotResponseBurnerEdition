+    if((method!=NV097_ARRAY_ELEMENT16&&method!=NV097_ARRAY_ELEMENT32)||!payload||!words||words>2047)return 0;
+    unsigned count=words*(4/width);
+    if(count<2||(width==2&&words==1)||count>MAX_INLINE_VERTS||g_pg.draw_mode!=6||g_pg.inline_count!=INLINE_VERT_DWORDS||
+       !gpu_vertices_active||!packed_draw_valid||raw_packet_active||
+       !vertex_fetch_plan.valid||!packed_capture_plan.valid||
+       packed_plan_revision!=vertex_fetch_plan.revision||packed_capture_plan.revision!=vertex_fetch_plan.revision||
+       packed_capture_plan.ram!=vertex_fetch_plan.ram||packed_capture_plan.stride!=packed_draw_layout.stride||
