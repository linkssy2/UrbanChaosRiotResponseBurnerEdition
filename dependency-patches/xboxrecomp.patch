+BOOL d3d8_combiners_set_nv097(const uint32_t *methods)
+{
+#if UCRR_PREPARATION_TRANSACTION
+    /* NULL only unbinds raw activation. Non-transaction raw preparation may
+     * replace the parsed state even when its caller later chooses a fallback. */
+    if(methods)g_transaction_owner=NULL;
+#endif
