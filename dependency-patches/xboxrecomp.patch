+static void convert_yuy2_pair(uint8_t *dst, const uint8_t *src)
+{
+    const int y0 = (int)src[0] - 16;
+    const int u = (int)src[1] - 128;
+    const int y1 = (int)src[2] - 16;
+    const int v = (int)src[3] - 128;
+    const int c0 = y0 < 0 ? 0 : y0;
+    const int c1 = y1 < 0 ? 0 : y1;
+    const int yc0 = 298 * c0 + 128;
+    const int yc1 = 298 * c1 + 128;
+    const int rv = 409 * v;
+    const int guv = -100 * u - 208 * v;
+    const int bu = 516 * u;
+    const int r0 = (yc0 + rv) >> 8;
+    const int g0 = (yc0 + guv) >> 8;
+    const int b0 = (yc0 + bu) >> 8;
+    const int r1 = (yc1 + rv) >> 8;
+    const int g1 = (yc1 + guv) >> 8;
+    const int b1 = (yc1 + bu) >> 8;
+
+    dst[0] = clamp_u8(b0);
+    dst[1] = clamp_u8(g0);
+    dst[2] = clamp_u8(r0);
+    dst[3] = 255;
+    dst[4] = clamp_u8(b1);
+    dst[5] = clamp_u8(g1);
+    dst[6] = clamp_u8(r1);
+    dst[7] = 255;
+}
