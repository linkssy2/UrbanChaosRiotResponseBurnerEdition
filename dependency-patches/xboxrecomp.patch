+static void convert_live_pixel(uint8_t *destination, const uint8_t *source,
+                               LiveTextureKind kind)
+{
+    uint16_t packed;
+    uint8_t luminance;
+
+    switch (kind) {
+    case LIVE_TEX_B8G8R8A8:
+        destination[0]=source[3];destination[1]=source[2];destination[2]=source[1];destination[3]=source[0];
+        break;
+    case LIVE_TEX_L8:
+        destination[0] = source[0];
+        destination[1] = source[0];
+        destination[2] = source[0];
+        destination[3] = 255;
+        break;
+    case LIVE_TEX_AY8:
+        luminance = (uint8_t)((source[0] & 0x0Fu) * 17u);
+        destination[0] = luminance;
+        destination[1] = luminance;
+        destination[2] = luminance;
+        destination[3] = (uint8_t)((source[0] >> 4) * 17u);
+        break;
+    case LIVE_TEX_A8:
+        destination[0] = 255;
+        destination[1] = 255;
+        destination[2] = 255;
+        destination[3] = source[0];
+        break;
+    case LIVE_TEX_A8Y8:
+        destination[0] = source[0];
+        destination[1] = source[0];
+        destination[2] = source[0];
+        destination[3] = source[1];
+        break;
+    case LIVE_TEX_A1R5G5B5:
+    case LIVE_TEX_X1R5G5B5:
+        memcpy(&packed, source, sizeof(packed));
+        destination[0] = expand_5_to_8(packed & 0x1Fu);
+        destination[1] = expand_5_to_8((packed >> 5) & 0x1Fu);
+        destination[2] = expand_5_to_8((packed >> 10) & 0x1Fu);
+        destination[3] = kind == LIVE_TEX_X1R5G5B5
+            ? 255 : ((packed & 0x8000u) ? 255 : 0);
+        break;
+    case LIVE_TEX_A4R4G4B4:
+        memcpy(&packed, source, sizeof(packed));
+        destination[0] = (uint8_t)((packed & 0x0Fu) * 17u);
+        destination[1] = (uint8_t)(((packed >> 4) & 0x0Fu) * 17u);
+        destination[2] = (uint8_t)(((packed >> 8) & 0x0Fu) * 17u);
+        destination[3] = (uint8_t)(((packed >> 12) & 0x0Fu) * 17u);
+        break;
+    case LIVE_TEX_R5G6B5:
+        memcpy(&packed, source, sizeof(packed));
+        destination[0] = expand_5_to_8(packed & 0x1Fu);
+        destination[1] = expand_6_to_8((packed >> 5) & 0x3Fu);
+        destination[2] = expand_5_to_8((packed >> 11) & 0x1Fu);
+        destination[3] = 255;
+        break;
+    case LIVE_TEX_A8R8G8B8:
+        memcpy(destination, source, 4u);
+        break;
+    case LIVE_TEX_X8R8G8B8:
+        memcpy(destination, source, 4u);
+        destination[3] = 255;
+        break;
+    default:
+        memset(destination, 0xFF, 4u);
+        break;
+    }
+}
