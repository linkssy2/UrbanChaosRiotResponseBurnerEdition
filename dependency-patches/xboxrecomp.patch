+#if UCRR_PREPARATION_TRANSACTION
+BOOL d3d8_combiners_compile_transaction(const uint32_t *methods,
+    D3D8CombinerTransaction *out)
+{
+    if(!methods||!out)return FALSE;
+    /* Parse at the original raw phase, after all earlier resource/state work.
+     * Unsupported results are not published and are retried by the old path. */
+    NV2ACombinerState state;
+    d3d8_combiners_from_nv097(methods,&state);
+    for(unsigned i=0;i<4;++i){
+        unsigned mode=state.tex_mode[i];
+        if(mode<=NV2A_TEXMODE_2D)continue;
+        if(mode<=NV2A_TEXMODE_CUBEMAP&&g_raw_lighting)continue;
+        if((mode!=15&&mode!=16)||!i||state.input_tex[i]>=i)return FALSE;
+    }
+    PreparedRawKey key;
+    typedef char transaction_key_size[sizeof(key)==sizeof(out->key)?1:-1];
+    prepared_raw_key(methods,&key);memcpy(out->key,&key,sizeof(key));
+    out->state=state;
+    return TRUE;
+}
