+typedef struct XboxVblankClock {
+    LARGE_INTEGER frequency;
+    LONGLONG next_deadline;
+    LONGLONG whole_ticks;
+    LONGLONG remainder_ticks;
+    LONGLONG remainder_accumulator;
+    BOOL initialized;
+} XboxVblankClock;
+
+static XboxVblankClock g_xbox_vblank_clock;
+
+/* BlockUntilVerticalBlank belongs to the Xbox's fixed 60 Hz display clock,
+ * not to the host monitor.  Letting DXGI provide this delay made a 120 Hz
+ * desktop wait for two compositor refreshes per Present, and real scheduling
+ * overhead frequently stretched that much further.  An absolute QPC deadline
+ * keeps the guest clock at 60 Hz on every desktop refresh rate. */
+static void xbox_wait_for_vblank(void)
+{
+    XboxVblankClock *clock = &g_xbox_vblank_clock;
+    LARGE_INTEGER now;
+
+    if (!clock->initialized) {
+        QueryPerformanceFrequency(&clock->frequency);
+        QueryPerformanceCounter(&now);
+        clock->whole_ticks = clock->frequency.QuadPart / 60;
+        clock->remainder_ticks = clock->frequency.QuadPart % 60;
+        clock->remainder_accumulator = 0;
+        clock->next_deadline = now.QuadPart;
+        clock->initialized = TRUE;
+        fprintf(stderr,
+                "D3D8: explicit Xbox vblank pacing 60 Hz (desktop %u Hz, DXGI sync interval %u)\n",
+                xbox_desktop_refresh_hz(g_device_state.hwnd), getenv("UCRR_ASYNC_PRESENT") ? 0u : 1u);
+    }
+
+    QueryPerformanceCounter(&now);
+
+    /* Never replay missed vblanks in a burst after a debugger pause, shader
+     * compilation, or an unexpectedly long decode.  Resume the 60 Hz cadence
+     * from the current instant instead. */
+    if (now.QuadPart > clock->next_deadline + clock->whole_ticks) {
+        clock->next_deadline = now.QuadPart;
+        clock->remainder_accumulator = 0;
+    }
+
+    for (;;) {
+        LONGLONG remaining;
+        QueryPerformanceCounter(&now);
+        remaining = clock->next_deadline - now.QuadPart;
+        if (remaining <= 0) break;
+
+        if (remaining > (clock->frequency.QuadPart * 2) / 1000) {
+            DWORD sleep_ms = (DWORD)((remaining * 1000) /
+                                     clock->frequency.QuadPart);
+            if (sleep_ms > 1) --sleep_ms;
+            Sleep(sleep_ms);
+        } else if (remaining > clock->frequency.QuadPart / 2000) {
+            SwitchToThread();
+        } else {
+            YieldProcessor();
+        }
+    }
+
+    clock->next_deadline += clock->whole_ticks;
+    clock->remainder_accumulator += clock->remainder_ticks;
+    if (clock->remainder_accumulator >= 60) {
+        ++clock->next_deadline;
+        clock->remainder_accumulator -= 60;
+    }
+}
