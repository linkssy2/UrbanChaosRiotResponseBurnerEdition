+    g_raw_active=FALSE;
+    if(!methods)return FALSE;
+    uc_host_upload_enter();
+    if(uc_host_upload_active())nv_host_upload_add(&nv_host_upload_counters,NV_HOST_UPLOAD_COMBINER_SET_CALLS,1);
+    PreparedRawKey key;
+    if(g_prepared_raw_enabled){
+        PREPARED_NOTE(activations);
+        prepared_raw_key(methods,&key);
+        if(g_prepared_raw_valid&&!memcmp(&key,&g_prepared_raw_key,sizeof(key))){
+            PREPARED_NOTE(hits);
+            if(uc_host_upload_active())nv_host_upload_add(&nv_host_upload_counters,NV_HOST_UPLOAD_COMBINER_PREPARED_HITS,1);
+            /* No intervening generic writer: both parsed state and the current
+             * raw shader key still belong to these exact immutable contents. */
+            g_raw_active=TRUE;g_current_raw_key_valid=g_raw_lookup_enabled;
+            return TRUE;
+        }
+        if(g_raw_constant_domain_enabled&&g_prepared_raw_valid&&
+           !memcmp(&key.shader,&g_prepared_raw_key.shader,sizeof(key.shader))){
+            /* Only packed colors changed. The structural owner still proves
+             * every parsed operation, supported texture route and shader key.
+             * Preserve the original per-stage replication flags exactly; even
+             * unused source colors stay in the copied key for safe misses.
+             * This performs no float conversion or host-context mutation.
+             * Eviction may clear the borrowed shader entry independently. */
+            for(unsigned i=0;i<8;++i){
+                g_combiner_state.c0[i]=key.c0[(g_combiner_state.flags&0x10)?i:0];
+                g_combiner_state.c1[i]=key.c1[(g_combiner_state.flags&0x100)?i:0];
+            }
+            g_combiner_state.final_c0=key.final_c0;
+            g_combiner_state.final_c1=key.final_c1;
+            g_prepared_raw_key=key;
+            PREPARED_NOTE(constant_updates);
+            /* Deliberately neither a full-key hit nor a full parse in the
+             * bounded host ledger. With this gate, sets-hits-parses counts
+             * constant-only updates; its 40-column schema is unchanged. */
+            g_raw_active=TRUE;g_current_raw_key_valid=g_raw_lookup_enabled;
+            return TRUE;
+        }
+        PREPARED_NOTE(rebuilds);
+        prepared_raw_invalidate();
+    }
+    NV2ACombinerState raw;
+    if(uc_host_upload_active())nv_host_upload_add(&nv_host_upload_counters,NV_HOST_UPLOAD_COMBINER_PARSES,1);
+    if(g_description_cache_enabled)description_prepare(&g_description_cache,methods,&raw);
+    else d3d8_combiners_from_nv097(methods,&raw);
+    /* The current vertex/texture adapter supplies only a stage-0 2D route.
+     * Never silently interpret cube/volume/dependent stages as 2D. */
+    for(unsigned i=0;i<4;++i){
+        unsigned mode=raw.tex_mode[i];
+        if(mode<=NV2A_TEXMODE_2D)continue;
+        if(mode<=NV2A_TEXMODE_CUBEMAP && g_raw_lighting)continue;
+        if((mode!=15 && mode!=16) || !i || raw.input_tex[i]>=i)return FALSE;
+    }
+    g_combiner_state=raw;g_raw_active=TRUE;
+    if(g_raw_lookup_enabled){
+        if(g_prepared_raw_enabled)g_current_raw_key=key.shader;
+        else raw_combiner_key(methods,&g_current_raw_key);
+        g_current_raw_key_valid=TRUE;
+    }
+    if(g_prepared_raw_enabled){g_prepared_raw_key=key;g_prepared_raw_valid=TRUE;}
+    return TRUE;
+}
