+def test_decode_function_stream_fills_gap_after_existing_prefix():
+    # The seed and its first successor were already decoded, but the sweep
+    # stepped over the following ret. Starting decode_at at the seed would stop
+    # on the existing successor; the stream helper must walk through it first.
+    data = b"\x8b\x44\x24\x04\x89\x05\x78\x56\x34\x12\xc3"
+    eng, _ = _engine(BASE, data)
+    eng.decode_at(BASE)
+    del eng.instructions[BASE + 10]
+
+    added = eng.decode_function_stream(BASE)
+
+    assert added == 1, added
+    assert eng.instructions[BASE + 10].is_ret
+
+
+def test_exact_function_stream_evicts_an_overlapping_decode():
+    # The correct six-byte store ends at BASE+10, but an out-of-phase sweep has
+    # also decoded a two-byte instruction from its final immediate byte. Exact
+    # recovery must remove that interior instruction while preserving the ret.
+    data = b"\x8b\x44\x24\x04\x89\x05\x78\x56\x34\x00\xc3"
+    eng, _ = _engine(BASE, data)
+    eng.decode_at(BASE)
+    eng.instructions[BASE + 9] = eng._classify_instruction(
+        next(eng._cs.disasm(data[9:], BASE + 9)))
+
+    eng.decode_function_stream(BASE, evict_overlaps=True)
+
+    assert (BASE + 9) not in eng.instructions
+    assert eng.instructions[BASE + 10].is_ret
+
