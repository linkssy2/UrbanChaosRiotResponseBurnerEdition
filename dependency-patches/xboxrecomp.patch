+static uint64_t live_texture_signature(const uint8_t *source, size_t size)
+{
+    uint64_t hash = 1469598103934665603ull ^ (uint64_t)size;
+    size_t offset = 0;
+
+    /* A full, cache-friendly 64-bit hash is still much cheaper than converting
+     * a 640x480 YUY2 frame and uploading 1.2 MiB to the GPU.  XMV commonly
+     * presents each decoded frame across two Xbox vblanks, so recognizing the
+     * unchanged buffer removes half of that work without guessing at cadence. */
+    while (offset + sizeof(uint64_t) <= size) {
+        uint64_t word;
+        memcpy(&word, source + offset, sizeof(word));
+        hash ^= word;
+        hash *= 1099511628211ull;
+        offset += sizeof(uint64_t);
+    }
+    while (offset < size) {
+        hash ^= source[offset++];
+        hash *= 1099511628211ull;
+    }
+    return hash;
+}
