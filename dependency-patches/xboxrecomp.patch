+        uint32_t fmt = valid ? voice_get_mask(d, (uint16_t)best, NV_PAVS_VOICE_CFG_FMT, UINT32_MAX) : 0;
+        uint32_t state = valid ? voice_get_mask(d, (uint16_t)best, NV_PAVS_VOICE_PAR_STATE, UINT32_MAX) : 0;
+        fprintf(stderr, "[APU-VOICE-LIFE] tick_ms=%llu frame=%u reset=%u voice=%u activation=%u empty_reads=%llu empty=%u empty_activation=%u age_q=%u end_activation=%u end_frame=%u end_q=%u end_reason=%u max_end_q=%u cfgA=%u@%u cfgB=%u@%u off=%u retire=%u release=%u pause=%u notify=%u@%u slot=%u valid=%u fmt=%08X state=%08X current=%u segment=%u A=%u:%u B=%u:%u bins=%08X vol=%08X:%08X:%08X\n",
+            (unsigned long long)GetTickCount64(), (uint32_t)d->ep_frame_div, d->lifecycle_reset_serial, best, t->activation,
+            (unsigned long long)t->interval_empty_reads, (unsigned)t->empty, t->empty_activation,
+            t->empty ? (uint32_t)d->ep_frame_div - t->empty_start : 0,
+            t->end_activation, t->end_frame, t->end_quanta, t->end_reason, t->max_empty_quanta,
+            t->config_count[0], t->config_frame[0], t->config_count[1], t->config_frame[1],
+            t->off_commands, t->retires, t->releases, t->pauses,
+            t->notify_count, t->notify_frame, t->notify_slot, (unsigned)valid, fmt, state,
+            d->vp.ssl[best].ssl_index, d->vp.ssl[best].ssl_seg,
+            d->vp.ssl[best].base[0], d->vp.ssl[best].count[0],
+            d->vp.ssl[best].base[1], d->vp.ssl[best].count[1],
+            valid ? voice_get_mask(d, (uint16_t)best, NV_PAVS_VOICE_CFG_VBIN, UINT32_MAX) : 0,
+            valid ? voice_get_mask(d, (uint16_t)best, NV_PAVS_VOICE_TAR_VOLA, UINT32_MAX) : 0,
+            valid ? voice_get_mask(d, (uint16_t)best, NV_PAVS_VOICE_TAR_VOLB, UINT32_MAX) : 0,
+            valid ? voice_get_mask(d, (uint16_t)best, NV_PAVS_VOICE_TAR_VOLC, UINT32_MAX) : 0);
+    }
+    fprintf(stderr, "[APU-VOICE-LIFE-COVERAGE] frame=%u candidates=%u emitted=%u omitted=%u report=%u/128\n",
+        (uint32_t)d->ep_frame_div, candidates, emitted, candidates-emitted, d->source_trace_reports+1);
+    for (unsigned v = 0; v < MCPX_HW_MAX_VOICES; ++v) {
+        d->lifecycle[v].interval_empty_reads = 0;
+        d->lifecycle[v].changed = false;
+    }
+}
