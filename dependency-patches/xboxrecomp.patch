+++ b/tools/disasm/engine.py
@@ -268,6 +268,52 @@ class DisasmEngine:
             self._sorted_addrs = None
         return added
 
+    def decode_function_stream(self, addr: int, max_insns: int = 4096,
+                               evict_overlaps: bool = False) -> int:
+        """Ensure a seeded function's linear stream reaches a terminator.
+
+        A sweep can decode the first few instructions at a seed correctly and
+        then miss a later byte. ``decode_at(seed)`` cannot repair that shape:
+        it sees the already-decoded second instruction, declares the streams
+        resynchronised, and stops before the gap. Walk the known chain and call
+        ``decode_at`` at each missing address until a terminator is reached.
+
+        When ``evict_overlaps`` is true, instruction starts inside a decoded
+        instruction's bytes are removed. This is reserved for hand-verified
+        entry points: an out-of-phase sweep may otherwise leave a bogus
+        function candidate in the middle of an immediate operand, truncating
+        the verified function before its ret.
+        """
+        added = 0
+        removed = 0
+        walked = 0
+        cursor = addr
+
+        while walked < max_insns:
+            insn = self.instructions.get(cursor)
+            if insn is None:
+                recovered = self.decode_at(cursor, max_insns - walked)
+                if recovered == 0:
+                    break
+                added += recovered
+                insn = self.instructions.get(cursor)
+                if insn is None:
+                    break
+
+            walked += 1
+            if evict_overlaps:
+                for overlap in range(cursor + 1, insn.end_address):
+                    if overlap in self.instructions:
+                        del self.instructions[overlap]
+                        removed += 1
+            if insn.is_terminator:
+                break
+            cursor = insn.end_address
+
+        if removed:
+            self._sorted_addrs = None
+        return added
+
     def recursive_descent(self, start_addresses: List[int],
                           section_bounds: List[Tuple[int, int]]) -> Set[int]:
         """
