+static uint8_t expand_5_to_8(uint32_t value)
+{
+    return (uint8_t)((value << 3) | (value >> 2));
+}
+
+static uint8_t expand_6_to_8(uint32_t value)
+{
+    return (uint8_t)((value << 2) | (value >> 4));
+}
