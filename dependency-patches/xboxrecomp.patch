+#include "nv2a_extreme_packet.h"
+static unsigned packed_extreme_span(uint32_t method,const uint8_t*payload,unsigned words,unsigned v,unsigned options){
+ unsigned misses=0;
+ if(raw_packets_enabled()){
+    unsigned raw=raw_capture_packet(method,payload,words,v);if(raw)return raw;
+    if(raw_packet_active){raw_packets_restore();return 0;}
