+                                         (ID3D11Resource *)g_gdi_present_staging[write_slot],
+                                         (ID3D11Resource *)back_buffer);
+        g_gdi_present_write = (write_slot + 1u) % GDI_PRESENT_RING_SIZE;
+        if (g_gdi_present_queued < GDI_PRESENT_RING_SIZE) {
+            ++g_gdi_present_queued;
+        }
