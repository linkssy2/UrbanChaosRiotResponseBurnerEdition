+            bitmap_info.header.biBitCount = 32;
+            bitmap_info.header.biCompression = BI_BITFIELDS;
+            bitmap_info.masks[0] = 0x000000FFu;
+            bitmap_info.masks[1] = 0x0000FF00u;
+            bitmap_info.masks[2] = 0x00FF0000u;
