+    for (unsigned row = 0; row < 4; ++row) {
+        unsigned best = MCPX_HW_MAX_VOICES;
+        for (unsigned v = 0; v < MCPX_HW_MAX_VOICES; ++v) {
+            ApuVoiceLifecycle *t = &d->lifecycle[v];
+            if (selected[v] || (!t->interval_empty_reads && !t->changed)) continue;
+            if (best == MCPX_HW_MAX_VOICES || t->interval_empty_reads > d->lifecycle[best].interval_empty_reads)
+                best = v;
+        }
