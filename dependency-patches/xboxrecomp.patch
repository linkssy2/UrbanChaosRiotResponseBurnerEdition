+/* Complete bounded source coverage, independent of the top-four starvation
+ * ranking. Counters span handle reuse; first/last activation makes that explicit.
+ * Routed peak is a contribution before later multipass/DSP processing, NOT
+ * evidence that this voice reached the speakers. Diagnostic-only, under lock. */
+static void trace_source_flow(MCPXAPUState *d)
+{
+    if (!apu_verbose_trace() || !lifecycle_enabled(d, 0)) return;
+    uint8_t reachable[MCPX_HW_MAX_VOICES] = {0};
+    unsigned invalid = 0;
+    for (unsigned list = 0; list < 3; ++list) {
+        unsigned v = d->regs[voice_list_regs[list].top];
+        while (v != 0xFFFF) {
+            if (v >= MCPX_HW_MAX_VOICES || (reachable[v] & (1u << list)) ||
+                !apu_ram_span((hwaddr)d->regs[NV_PAPU_VPVADDR] + v * NV_PAVS_SIZE, NV_PAVS_SIZE)) {
+                ++invalid; break;
+            }
+            reachable[v] |= (uint8_t)(1u << list);
+            v = voice_get_mask(d, (uint16_t)v, NV_PAVS_VOICE_TAR_PITCH_LINK,
+                               NV_PAVS_VOICE_TAR_PITCH_LINK_NEXT_VOICE_HANDLE);
+        }
+    }
+    unsigned emitted = 0;
+    for (unsigned v = 0; v < MCPX_HW_MAX_VOICES; ++v) {
+        ApuVoiceLifecycle *t = &d->lifecycle[v];
+        bool valid = apu_ram_span((hwaddr)d->regs[NV_PAPU_VPVADDR] + v * NV_PAVS_SIZE, NV_PAVS_SIZE);
+        uint32_t fmt = valid ? voice_get_mask(d, (uint16_t)v, NV_PAVS_VOICE_CFG_FMT, UINT32_MAX) : 0;
+        uint32_t state = valid ? voice_get_mask(d, (uint16_t)v, NV_PAVS_VOICE_PAR_STATE, UINT32_MAX) : 0;
+        bool active_source = (state & NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE) &&
+                             !(fmt & NV_PAVS_VOICE_CFG_FMT_MULTIPASS);
+        if (!t->flow_requested && !active_source) continue;
+        ++emitted;
+        fprintf(stderr, "[APU-SOURCE-FLOW] frame=%u voice=%u first_activation=%u last_activation=%u requested=%u produced=%u routed_peak=%.7f routes=%08X reachable=%u valid=%u fmt=%08X state=%08X current=%u A=%u:%u B=%u:%u\n",
+            (uint32_t)d->ep_frame_div, v, t->flow_first_activation, t->activation,
+            t->flow_requested, t->flow_produced, t->flow_peak, t->flow_routes,
+            reachable[v], (unsigned)valid, fmt, state, d->vp.ssl[v].ssl_index,
+            d->vp.ssl[v].base[0], d->vp.ssl[v].count[0], d->vp.ssl[v].base[1], d->vp.ssl[v].count[1]);
+        t->flow_requested = t->flow_produced = t->flow_routes = t->flow_first_activation = 0;
+        t->flow_peak = 0;
+    }
+    fprintf(stderr, "[APU-SOURCE-FLOW-COVERAGE] frame=%u emitted=%u invalid_chains=%u report=%u/128\n",
+        (uint32_t)d->ep_frame_div, emitted, invalid, d->source_trace_reports + 1);
+}
